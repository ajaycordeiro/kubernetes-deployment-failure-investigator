# Copy this file to .env for local development.
# Never commit a populated .env file.

NEBIUS_API_KEY=
NEBIUS_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# The application fixes the endpoint to:
# https://api.tokenfactory.nebius.com/v1/

# --- Evidence source (optional; operator configuration, never user input) ---
# Leave both unset to use pasted evidence or a bundled synthetic case.

# Point at a directory of captured `kubectl ... -o json` output.
# See "Capturing a cluster snapshot" in README.md for the exact commands.
# K8S_SNAPSHOT_DIR=./snapshots/orders

# Read from a reachable cluster with read-only API calls. Use a local or
# throwaway cluster; never point this at production.
# K8S_LIVE_CLUSTER=true
# K8S_CONTEXT=kind-kind
