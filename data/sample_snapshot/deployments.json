{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "checkout-api",
        "namespace": "checkout"
      },
      "spec": {
        "replicas": 2,
        "template": {
          "spec": {
            "containers": [
              {
                "name": "checkout-api",
                "image": "registry.example.internal/checkout/checkout-api:v3.2.0-rc4",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080,
                    "protocol": "TCP"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "200m",
                    "memory": "256Mi"
                  }
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/ready",
                    "port": 8080
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 10
                }
              }
            ],
            "imagePullSecrets": [
              {
                "name": "internal-registry"
              }
            ]
          }
        }
      },
      "status": {
        "replicas": 2,
        "readyReplicas": 0,
        "availableReplicas": 0,
        "unavailableReplicas": 2
      }
    }
  ]
}
